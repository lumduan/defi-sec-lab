#!/usr/bin/env bash
# pre-push: scan the commits being pushed with gitleaks (rules in .gitleaks.toml), inside the pinned hooks image.
# Second local gate: catches secrets in commits made with `git commit --no-verify`. FAILS CLOSED.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

fail_closed() {
  echo "pre-push: BLOCKED. The secret scan could not run: $1" >&2
  exit 1
}
command -v docker >/dev/null 2>&1 || fail_closed "docker not found"
image="$("$root/scripts/hooks-image.sh")" || fail_closed "could not build the hooks image"

zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                  # deleting a remote ref: nothing to scan
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"                    # new branch: commits not on any remote yet
  else
    range="$remote_sha..$local_sha"
  fi
  echo "pre-push: gitleaks scanning $local_ref ($range)" >&2
  docker run --rm --user "$(id -u):$(id -g)" -v "$root:$root:ro" -w "$root" "$image" \
    gitleaks git "$root" --config "$root/.gitleaks.toml" --redact --verbose --no-banner \
    --log-opts="$range" || status=1
done
[ "$status" -eq 0 ] || echo "pre-push: BLOCKED. gitleaks found secrets in the commits being pushed (see above)." >&2
exit "$status"
